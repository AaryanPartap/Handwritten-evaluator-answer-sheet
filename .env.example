# Handwritten Answer Evaluator Configuration

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5000

# Authentication & Security
SECRET_KEY=super-secret-evaluator-jwt-key-pec-cse-2026

# LLM Evaluator Service (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Configuration (Optional - runs in local storage/DB mode if not provided)
USE_FIREBASE=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# OCR Configuration
OCR_ENGINE=mock_trocr  # Options: mock_trocr, trocr, cloud_vision
GOOGLE_APPLICATION_CREDENTIALS=
